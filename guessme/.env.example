# URL base da GuessMe API.
# Desenvolvimento local (padrão se não definida): http://localhost:8080
# Produção: substitua pelo endereço real do backend antes de rodar npm run build.
#
# Esta variável é embutida no bundle em tempo de build.
# Alterar o valor exige um novo npm run build.
#
# CORS: certifique-se de que o backend aceita requisições da origem do frontend.
# Configure CORS_ALLOWED_ORIGINS no backend com a URL de produção do frontend.
VITE_API_BASE_URL=http://localhost:8080
